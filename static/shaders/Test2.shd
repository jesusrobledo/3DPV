attributes:
  0:
    name: 'position2'
    size: 3
    type: 'float'

uniforms:
  0:
    name: 'value2'
    type: 'f'

vertexShader: '#version 300 es
              in vec3 position;
              void main() {
                gl_Position = vec4(position, 1.0);
              };'

fragmentShader: '#version 300 es
                precision highp float;
                out vec4 outColor;
                void main() {
                  outColor = vec4(1.0, 0.3, 0.3, 1.0);
                };'